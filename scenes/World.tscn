[node name="NPC01" parent="WorldContent" instance=ExtResource("9_npc")]
npc_name = "Mara"
dialogue_text = "The innkeeper keeps the best stories in town. If you have time, stop in and listen."
position = Vector2(-140, -20)

[node name="NPC02" parent="WorldContent" instance=ExtResource("9_npc")]
npc_name = "Jonas"
dialogue_text = "The road north is quiet most days. Keep your eyes open once the trees get thicker."
position = Vector2(140, -20)

[node name="NPC03" parent="WorldContent" instance=ExtResource("9_npc")]
npc_name = "Elena"
dialogue_text = "The shop carries useful supplies for travelers. Do not leave town without checking your equipment."
position = Vector2(-120, 140)

[node name="NPC04" parent="WorldContent" instance=ExtResource("9_npc")]
npc_name = "Thomas"
dialogue_text = "The church is a peaceful place. You should visit it before heading into dangerous territory."
position = Vector2(120, 140)

[node name="NPC05" parent="WorldContent" instance=ExtResource("9_npc")]
npc_name = "Rina"
dialogue_text = "The farms outside town help keep everyone fed. Life here is simple, but that is not always a bad thing."
position = Vector2(-250, -30)

[node name="NPC06" parent="WorldContent" instance=ExtResource("9_npc")]
npc_name = "Gareth"
dialogue_text = "If you are heading beyond the town, make sure you are ready. The wilderness does not care how confident you feel."
position = Vector2(250, 30)

[node name="QuestGiver" parent="WorldContent" instance=ExtResource("9_npc")]
