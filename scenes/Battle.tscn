horizontal_alignment = 1

[node name="StateLabel" type="Label" parent="CenterContainer/Panel/VBoxContainer"]
layout_mode = 2
text = "PLAYER TURN"
horizontal_alignment = 1

[node name="ActionLabel" type="Label" parent="CenterContainer/Panel/VBoxContainer"]
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
text = "Choose an action."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

[node name="PlayerHPLabel" type="Label" parent="CenterContainer/Panel/VBoxContainer"]
layout_mode = 2
text = "Player HP: 100 / 100"
horizontal_alignment = 1

[node name="PlayerHPBar" type="ProgressBar" parent="CenterContainer/Panel/VBoxContainer"]
custom_minimum_size = Vector2(0, 18)
