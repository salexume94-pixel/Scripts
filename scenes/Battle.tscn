[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="CenterContainer"]
custom_minimum_size = Vector2(580, 600)
layout_mode = 2

[node name="VBoxContainer" type="VBoxContainer" parent="CenterContainer/Panel"]
layout_mode = 2
theme_override_constants/separation = 3

[node name="TitleLabel" type="Label" parent="CenterContainer/Panel/VBoxContainer"]
layout_mode = 2
text = "BATTLE"
horizontal_alignment = 1

[node name="EncounterLabel" type="Label" parent="CenterContainer/Panel/VBoxContainer"]
layout_mode = 2
text = "Combat Encounter: Unknown"
horizontal_alignment = 1

[node name="PlayerWeaknessLabel" type="Label" parent="CenterContainer/Panel/VBoxContainer"]
layout_mode = 2
text = "Player Weakness: Unknown"
horizontal_alignment = 1

[node name="CycleWeaknessButton" type="Button" parent="CenterContainer/Panel/VBoxContainer"]
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
text = "Cycle Player Weakness"
[connection signal="pressed" from="CenterContainer/Panel/VBoxContainer/CycleWeaknessButton" to="." method="_on_cycle_weakness_pressed"]

[node name="EnemyBehaviorLabel" type="Label" parent="CenterContainer/Panel/VBoxContainer"]
layout_mode = 2
