[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/options_menu.gd" id="1_options"]

[node name="OptionsMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_options")

[node name="Dimmer" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.02, 0.03, 0.72)
mouse_filter = 1

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(420, 260)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="OptionsVBox" type="VBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Center/Panel/Margin/OptionsVBox"]
layout_mode = 2
text = "OPTIONS"
horizontal_alignment = 1

[node name="BrightnessLabel" type="Label" parent="Center/Panel/Margin/OptionsVBox"]
layout_mode = 2
text = "Brightness"

[node name="BrightnessSlider" type="HSlider" parent="Center/Panel/Margin/OptionsVBox"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
min_value = 0.25
max_value = 1.0
step = 0.05
value = 1.0
size_flags_horizontal = 3
[connection signal="value_changed" from="Center/Panel/Margin/OptionsVBox/BrightnessSlider" to="." method="_on_brightness_changed"]

[node name="VolumeLabel" type="Label" parent="Center/Panel/Margin/OptionsVBox"]
layout_mode = 2
text = "Audio Volume"

[node name="VolumeSlider" type="HSlider" parent="Center/Panel/Margin/OptionsVBox"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
min_value = 0.0
max_value = 1.0
step = 0.05
value = 0.8
size_flags_horizontal = 3
[connection signal="value_changed" from="Center/Panel/Margin/OptionsVBox/VolumeSlider" to="." method="_on_volume_changed"]

[node name="BackButton" type="Button" parent="Center/Panel/Margin/OptionsVBox"]
layout_mode = 2
text = "Back"
[connection signal="pressed" from="Center/Panel/Margin/OptionsVBox/BackButton" to="." method="_on_back_button_pressed"]
